APP_ENV=container-local
APP_HOST=0.0.0.0
APP_PORT=8000
DATA_DIR=data

# AWS / Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_GENERATE_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_VISION_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
TRACK_USAGE=true
WORKER_CONCURRENCY=3
MAX_WORKER_CONCURRENCY=6

# OpenSearch
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200

# Postgres
POSTGRES_USER=docsearch
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=docsearch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=documents

# Confluence (optional)
CONFLUENCE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# BookStack
BOOKSTACK_URL=http://bookstack:80
BOOKSTACK_TOKEN_ID=
BOOKSTACK_TOKEN_SECRET=
