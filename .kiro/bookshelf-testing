"CMD-SHELL\", \"pg_isready -U docsearch\"]\n      interval: 5s\n      timeout: 3s\n      retries: 5\n\n  # ── MinIO (S3-compatible object storage) ──────────────────\n  minio:\n    image: minio/minio:latest\n    command: server /data --console-address \":9001\"\n    env_file: local.env\n    ports:\n      - \"9000:9000\"\n      - \"9001:9001\"\n    volumes:\n      - minio_data:/data\n    healthcheck:\n      test: [\"CMD\", \"mc\", \"ready\", \"local\"]\n      interval: 10s\n      timeout: 5s\n      retries: 5\n\n  # ── BookStack (local wiki for document management) ────────\n  bookstack:\n    image: lscr.io/linuxserver/bookstack:latest\n    ports:\n      - \"6875:80\"\n    environment:\n      - APP_URL=http://localhost:6875\n      - DB_HOST=bookstack-db\n      - DB_PORT=3306\n      - DB_USER=bookstack\n      - DB_PASS=bookstack_local\n      - DB_DATABASE=bookstack\n    depends_on:\n      bookstack-db:\n        condition: service_healthy\n    volumes:\n      - bookstack_data:/config\n\n  bookstack-db:\n    image: mysql:8.0\n    environment:\n      - MYSQL_ROOT_PASSWORD=bookstack_root\n      - MYSQL_DATABASE=bookstack\n      - MYSQL_USER=bookstack\n      - MYSQL_PASSWORD=bookstack_local\n    volumes:\n      - bookstack_db_data:/var/lib/mysql\n    healthcheck:\n      test: [\"CMD\", \"mysqladmin\", \"ping\", \"-h\", \"localhost\", \"-u\", \"bookstack\", \"-pbookstack_local\"]\n      interval: 5s\n      timeout: 3s\n      retries: 10\n\n  # ── Reverse Proxy (HTTPS profile only) ────────────────────\n  reverse-proxy:\n    image: caddy:2-alpine\n    profiles: [\"https\"]\n    ports:\n      - \"80:80\"\n      - \"443:443\"\n    volumes:\n      - ../caddy/Caddyfile:/etc/caddy/Caddyfile:ro\n      - ../certs:/etc/caddy/certs:ro\n      - caddy_data:/data\n    depends_on:\n      api:\n        condition: service_healthy\n\nvolumes:\n  opensearch_data:\n  postgres_data:\n  minio_data:\n  api_data:\n  caddy_data:\n  bookstack_data:\n  bookstack_db_data:\n",
